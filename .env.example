# Postgres with pgvector. Local default matches docker-compose.yml.
# For Tiger Cloud, paste the service URL from the console instead.
DATABASE_URL=postgres://stallsheet:stallsheet@localhost:54329/stallsheet

PORT=3000

# Open-weight Gemma through any OpenAI-compatible chat endpoint.
# Local Ollama:  http://127.0.0.1:11434/v1   model gemma3:4b
# Hosted demo:   https://generativelanguage.googleapis.com/v1beta/openai/   model gemma-3-4b-it
GEMMA_BASE_URL=http://127.0.0.1:11434/v1
GEMMA_MODEL=gemma3:4b
GEMMA_API_KEY=

# TabPFN-3.5. Create a free non-commercial key at https://platform.priorlabs.ai
TABPFN_TOKEN=

# Optional. The sheet still generates when these are empty.
SERPAPI_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
SENTRY_DSN=
